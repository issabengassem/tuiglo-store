# Copy to .env.local (gitignored) and fill in real values. Never commit this
# file with real values in it.
#
# Used by lib/sheets/google-auth.ts and lib/sheets/orders-sheet.ts
# (app/api/orders/route.ts) to write completed checkout orders to the
# "Orders" tab of the TUIGLO Data Google Sheet. This is a separate
# credential from the "Google Sheets account" OAuth2 credential already
# used by the n8n "Future tuiglo" workflow — the website must not reuse it.
#
# Setup:
#   1. Google Cloud Console -> create (or reuse) a project -> enable the
#      "Google Sheets API".
#   2. Create a Service Account, then create a JSON key for it.
#   3. Open the TUIGLO Data Google Sheet -> Share -> add the service
#      account's client_email as an Editor.
#   4. Fill the two values below from that JSON key file.

# Set to "1" to skip Google Fonts download at build time (useful for CI/CD/offline).
# When set, next/font will not download Lora / IBM Plex Sans Arabic / Montserrat
# and will only generate CSS variable references — the browser will use system
# fonts or you can add <link> tags for font loading at runtime.
NEXT_PUBLIC_SKIP_FONT_DOWNLOAD=1

# The service account's "client_email" field.
GOOGLE_SHEETS_CLIENT_EMAIL=

# The service account's "private_key" field, pasted as one line with
# literal \n sequences (do not insert real newlines) — the JSON key file
# already has it in this form.
GOOGLE_SHEETS_PRIVATE_KEY=

# The spreadsheet ID from its URL. Not secret (already documented in
# MEMORY.md) — pre-filled with the real "Tuiglo Data" sheet. Override with a
# separate test sheet's ID during development if you don't want test orders
# landing in the production sheet.
GOOGLE_SHEETS_SPREADSHEET_ID=143gJNH6I3lLPjyJ7Pi0UEczi_d8FbpokCdu-24b5yss
